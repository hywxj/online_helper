{
  "name": "@local/online_helper",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Online Helper: a DeepSeek Harness plugin for course video playback and site rule management.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/*.mjs",
    "rules/*.json",
    "RULES.md",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "author": "hywxj <huwenju441@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/hywxj/online_helper.git"
  },
  "homepage": "https://github.com/hywxj/online_helper#readme",
  "bugs": {
    "url": "https://github.com/hywxj/online_helper/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node selftest.mjs && node --test",
    "check": "node --check index.js && node --check client.js"
  }
}
